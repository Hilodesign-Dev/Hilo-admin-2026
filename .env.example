# ── Hilo Platform — local / test Supabase ───────────────────────────────────
# 1. Create a project at https://supabase.com/dashboard
# 2. Copy Project URL + anon (public) key from Settings → API
# 3. cp .env.example .env.local
# 4. Fill values below, then run SQL in supabase/dev-bootstrap.sql
# 5. npm run dev

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: only for local scripts (never commit, never put in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
